[Unit]
Requires=freskoqa-staging-network-guard.service
After=freskoqa-staging-network-guard.service
Description=Fresko isolated disposable staging mariadb
After=network.target
[Service]
User=freskoqa
Group=freskoqa
WorkingDirectory=/home/freskoqa/fresko-private-staging-20261017
ExecStart=/usr/sbin/mariadbd --defaults-file=/home/freskoqa/fresko-private-staging-20261017/config/mariadb.cnf
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/freskoqa/fresko-private-staging-20261017
InaccessiblePaths=/home/frappe
[Install]
WantedBy=multi-user.target
