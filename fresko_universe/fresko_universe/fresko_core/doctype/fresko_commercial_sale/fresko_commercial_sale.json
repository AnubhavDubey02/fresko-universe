  {"fieldname": "as_of_recorded_at", "fieldtype": "Datetime", "label": "As of Recorded At", "description": "Capture/as-of timestamp.", "reqd": 1, "read_only": 1},
  {"fieldname": "lines", "fieldtype": "Table", "label": "Commercial Sale Lines", "options": "Fresko Commercial Sale Line", "reqd": 1, "read_only": 1}
