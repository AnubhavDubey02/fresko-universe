{
 "doctype": "DocType",
 "name": "Fresko Exception",
 "module": "Fresko Core",
 "engine": "InnoDB",
 "autoname": "hash",
 "track_changes": 1,
 "allow_rename": 0,
 "title_field": "exception_type",
 "search_fields": "exception_type,severity,status,container,deal",
 "fields": [
  {
   "fieldname": "exception_type",
   "fieldtype": "Select",
   "label": "Exception Type",
   "reqd": 1,
   "in_list_view": 1,
   "options": "BUYER_UNRESOLVED\nDUPLICATE_MESSAGE\nOVERSELL_OVERRIDE\nSTOCK_SHORTFALL\nRATE_FLOOR_BREACH\nRATE_POLICY_MISSING\nDATA_INTEGRITY\nOTHER"
  },
  {
   "fieldname": "severity",
   "fieldtype": "Select",
   "label": "Severity",
   "reqd": 1,
   "default": "Medium",
   "in_list_view": 1,
   "options": "Info\nLow\nMedium\nHigh\nCritical\nMaterial"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "reqd": 1,
   "default": "Open",
   "in_list_view": 1,
   "options": "Open\nIn Progress\nResolved\nWaived\nCancelled"
  },
  {
   "fieldname": "container",
   "fieldtype": "Link",
   "label": "Container",
   "options": "Fresko Container"
  },
  {
   "fieldname": "deal",
   "fieldtype": "Link",
   "label": "Deal",
   "options": "Fresko Deal"
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description",
   "reqd": 1
  },
  {
   "fieldname": "resolution_notes",
   "fieldtype": "Small Text",
   "label": "Resolution Notes"
  },
  {
   "fieldname": "opened_by",
   "fieldtype": "Link",
   "label": "Opened By",
   "options": "User",
   "default": "__user",
   "read_only": 1
  },
  {
   "fieldname": "opened_at",
   "fieldtype": "Datetime",
   "label": "Opened At",
   "default": "Now",
   "read_only": 1
  },
  {
   "fieldname": "resolved_by",
   "fieldtype": "Link",
   "label": "Resolved By",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "resolved_at",
   "fieldtype": "Datetime",
   "label": "Resolved At",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 0,
   "print": 1,
   "email": 0,
   "if_owner": 0
  },
  {
   "role": "Fresko Approver",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 0,
   "print": 1,
   "email": 0,
   "if_owner": 0
  },
  {
   "role": "Fresko Accounts",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 0,
   "print": 1,
   "email": 0,
   "if_owner": 0
  },
  {
   "role": "Fresko Salesperson",
   "read": 1,
   "write": 0,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 0,
   "import": 0,
   "share": 0,
   "print": 1,
   "email": 0,
   "if_owner": 0
  }
 ]
}
