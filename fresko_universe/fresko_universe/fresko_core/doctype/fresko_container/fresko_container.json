{
 "doctype": "DocType",
 "name": "Fresko Container",
 "module": "Fresko Core",
 "engine": "InnoDB",
 "is_submittable": 0,
 "track_changes": 1,
 "allow_rename": 0,
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "title_field": "container_no",
 "search_fields": "container_no,supplier,item,status",
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "reqd": 1,
   "options": "CON-.YYYY.-.",
   "default": "CON-.YYYY.-."
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1
  },
  {
   "fieldname": "container_no",
   "fieldtype": "Data",
   "label": "Container No",
   "reqd": 1
  },
  {
   "fieldname": "supplier",
   "fieldtype": "Link",
   "label": "Supplier Partner",
   "options": "Supplier",
   "reqd": 1
  },
  {
   "fieldname": "country_of_origin",
   "fieldtype": "Link",
   "label": "Country of Origin",
   "options": "Country"
  },
  {
   "fieldname": "item",
   "fieldtype": "Link",
   "label": "Product",
   "options": "Item",
   "reqd": 1
  },
  {
   "fieldname": "item_name",
   "fieldtype": "Data",
   "label": "Item Name",
   "fetch_from": "item.item_name",
   "read_only": 1
  },
  {
   "fieldname": "arrival_date",
   "fieldtype": "Date",
   "label": "Arrival Date",
   "reqd": 1
  },
  {
   "fieldname": "warehouse",
   "fieldtype": "Link",
   "label": "Inward Warehouse",
   "options": "Warehouse"
  },
  {
   "fieldname": "inward_qty",
   "fieldtype": "Float",
   "label": "Inward Qty",
   "reqd": 1
  },
  {
   "fieldname": "uom",
   "fieldtype": "Link",
   "label": "Unit",
   "options": "UOM",
   "reqd": 1
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "Currency",
   "options": "Currency",
   "reqd": 1
  },
  {
   "fieldname": "landed_cost",
   "fieldtype": "Currency",
   "label": "Landed Cost (Ops)"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "reqd": 1,
   "default": "Draft",
   "options": "Draft\nExpected\nArrived\nIn Cold Storage\nSelling\nClosing\nClosed\nCancelled"
  },
  {
   "fieldname": "closing_status",
   "fieldtype": "Select",
   "label": "Closing Status",
   "reqd": 1,
   "default": "Open",
   "options": "Open\nReady to Close\nClosed with Exceptions\nFully Reconciled\nCancelled"
  },
  {
   "fieldname": "default_rate_floor",
   "fieldtype": "Currency",
   "label": "Default Rate Floor"
  },
  {
   "fieldname": "default_rate_ceiling",
   "fieldtype": "Currency",
   "label": "Default Rate Ceiling"
  },
  {
   "fieldname": "opening_notes",
   "fieldtype": "Small Text",
   "label": "Opening Notes"
  },
  {
   "fieldname": "lots",
   "fieldtype": "Table",
   "label": "Lots",
   "options": "Fresko Container Lot"
  },
  {
   "fieldname": "rate_rules",
   "fieldtype": "Table",
   "label": "Rate Rules (Count/Size)",
   "options": "Fresko Container Rate Rule"
  },
  {
   "fieldname": "source_documents",
   "fieldtype": "Table",
   "label": "Source Documents",
   "options": "Fresko Container Source Document"
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "label": "Amended From",
   "options": "Fresko Container",
   "read_only": 1,
   "hidden": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1,
   "if_owner": 0
  },
  {
   "role": "Fresko Approver",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 0,
   "print": 1,
   "email": 1,
   "if_owner": 0
  },
  {
   "role": "Fresko Accounts",
   "read": 1,
   "write": 1,
   "create": 0,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 0,
   "print": 1,
   "email": 1,
   "if_owner": 0
  },
  {
   "role": "Fresko Salesperson",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 0,
   "import": 0,
   "share": 0,
   "print": 1,
   "email": 0,
   "if_owner": 0
  }
 ]
}
