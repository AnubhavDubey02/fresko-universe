  {"fieldname": "lot_state", "fieldtype": "Select", "label": "Lot State", "options": "KNOWN\nUNKNOWN\nCONTRADICTED", "default": "UNKNOWN", "reqd": 1, "read_only": 1, "in_list_view": 1},
  {"fieldname": "qty", "fieldtype": "Data", "label": "Quantity", "description": "Canonical decimal text; nullable (UNKNOWN never zero).", "read_only": 1, "in_list_view": 1},
  {"fieldname": "uom", "fieldtype": "Link", "label": "UOM", "options": "UOM", "reqd": 1, "read_only": 1, "in_list_view": 1},
  {"fieldname": "qty_state", "fieldtype": "Select", "label": "Quantity State", "options": "KNOWN\nUNKNOWN\nCONTRADICTED", "default": "UNKNOWN", "reqd": 1, "read_only": 1, "in_list_view": 1},
  {"fieldname": "price_state", "fieldtype": "Select", "label": "Price State", "options": "UNKNOWN\nPROPOSED\nFINAL\nREJECTED", "default": "UNKNOWN", "reqd": 1, "read_only": 1, "in_list_view": 1},
  {"fieldname": "rate", "fieldtype": "Data", "label": "Rate", "description": "Canonical decimal text; only proposed/final.", "read_only": 1, "in_list_view": 1},
