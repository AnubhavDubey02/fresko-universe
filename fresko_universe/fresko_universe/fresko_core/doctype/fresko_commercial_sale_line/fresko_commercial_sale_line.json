  {"fieldname": "amount", "fieldtype": "Data", "label": "Amount", "description": "Server-derived Decimal product.", "read_only": 1, "in_list_view": 1},
  {"fieldname": "bucket_key", "fieldtype": "Data", "label": "Bucket Key", "description": "Required for PRICE_BUCKET; unique per Sale.", "read_only": 1},
  {"fieldname": "source_line_ref", "fieldtype": "Data", "label": "Source Line Reference", "description": "Raw source row.", "read_only": 1},
  {"fieldname": "evidence", "fieldtype": "Link", "label": "Evidence", "options": "Fresko Evidence", "description": "Line/rate evidence.", "reqd": 1, "read_only": 1}
 ],
