  {"role": "Fresko Accounts", "read": 1, "write": 0, "create": 0, "delete": 0, "submit": 0, "cancel": 0, "amend": 0, "report": 1, "export": 1, "import": 0, "share": 0, "print": 1, "email": 0, "if_owner": 0},
  {"role": "Fresko Salesperson", "read": 1, "write": 0, "create": 0, "delete": 0, "submit": 0, "cancel": 0, "amend": 0, "report": 1, "export": 0, "import": 0, "share": 0, "print": 1, "email": 0, "if_owner": 0}
