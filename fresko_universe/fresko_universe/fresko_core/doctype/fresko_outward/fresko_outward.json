{
 "doctype": "DocType",
 "name": "Fresko Outward",
 "module": "Fresko Core",
 "engine": "InnoDB",
 "is_submittable": 0,
 "track_changes": 0,
 "allow_rename": 0,
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
