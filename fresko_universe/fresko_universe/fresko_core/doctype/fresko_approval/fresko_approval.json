{
 "doctype": "DocType",
 "name": "Fresko Approval",
 "module": "Fresko Core",
 "engine": "InnoDB",
 "is_submittable": 0,
 "track_changes": 0,
 "allow_rename": 0,
 "autoname": "hash",
 "title_field": "deal",
 "search_fields": "deal,decision,approver",
 "fields": [
  {
   "fieldname": "deal",
   "fieldtype": "Link",
   "label": "Deal",
   "options": "Fresko Deal",
   "reqd": 1
  },
  {
   "fieldname": "decision",
   "fieldtype": "Select",
   "label": "Decision",
   "reqd": 1,
   "in_list_view": 1,
   "options": "APPROVE\nCOUNTER\nREJECT\nOVERSELL_OVERRIDE"
  },
  {
   "fieldname": "decision_rate",
   "fieldtype": "Currency",
   "label": "Decision Rate"
  },
  {
   "fieldname": "proposed_rate",
   "fieldtype": "Currency",
   "label": "Proposed Rate (Snapshot)",
   "read_only": 1
  },
  {
   "fieldname": "rate_floor",
   "fieldtype": "Currency",
   "label": "Rate Floor (Snapshot)",
   "read_only": 1
  },
  {
   "fieldname": "rate_ceiling",
   "fieldtype": "Currency",
   "label": "Rate Ceiling (Snapshot)",
   "read_only": 1
  },
  {
   "fieldname": "approver",
   "fieldtype": "Link",
   "label": "Approver",
   "options": "User",
   "reqd": 1,
   "default": "__user"
  },
  {
   "fieldname": "decided_at",
   "fieldtype": "Datetime",
   "label": "Decided At",
   "reqd": 1,
   "default": "Now"
  },
  {
   "fieldname": "reason",
   "fieldtype": "Small Text",
   "label": "Reason",
   "reqd": 1
  },
  {
   "fieldname": "oversell_override",
   "fieldtype": "Check",
   "label": "Oversell Override",
   "default": 0
  },
  {
   "fieldname": "exception",
   "fieldtype": "Link",
   "label": "Linked Exception",
   "options": "Fresko Exception",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 0,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 0,
   "print": 1,
   "email": 0,
   "if_owner": 0
  },
  {
   "role": "Fresko Approver",
   "read": 1,
   "write": 0,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 0,
   "print": 1,
   "email": 0,
   "if_owner": 0
  },
  {
   "role": "Fresko Accounts",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 0,
   "print": 1,
   "email": 0,
   "if_owner": 0
  },
  {
   "role": "Fresko Salesperson",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
