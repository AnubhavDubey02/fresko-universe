# Store and check out text as LF on every platform. Hash-pinned fixtures,
# payload SHA idempotency keys and scripts/ci_bench.sh depend on exact LF bytes;
# a Windows core.autocrlf checkout must not rewrite them.
* text=auto eol=lf

*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.js text eol=lf
*.css text eol=lf

# Source workbooks and images are byte-exact evidence, never text.
*.xlsx binary
*.xls binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
